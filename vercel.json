{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/governing-board.php", "destination": "/board-of-directors", "permanent": true },
    { "source": "/corporate-ngo-partnership.php", "destination": "/corporate-partners", "permanent": true },
    { "source": "/knowledge-partners.php", "destination": "/knowledge-partners", "permanent": true },
    { "source": "/employment-partners.php", "destination": "/employment-partners", "permanent": true },
    { "source": "/foundation-partners.php", "destination": "/foundation-partners", "permanent": true },
    { "source": "/government-partnership-programme.php", "destination": "/government-partnership-programme", "permanent": true },
    { "source": "/work-with-us.php", "destination": "/work-with-us", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Content-Security-Policy", "value": "upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
